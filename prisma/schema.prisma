generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  BUILDING_OWNER
  BUILDING_ADMIN
  COMPANY_ADMIN
  EMPLOYEE
}

model User {
  id       String   @id @default(cuid())
  userId   String   @unique
  username String
  password String   @default("")
  role     UserRole
  permissions String[] @default([])
  permissionsCustomized Boolean @default(false)

  buildingId String?
  companyId  String?
  createdBySuperAdminId String?

  building Building? @relation("BuildingUsers", fields: [buildingId], references: [id], onDelete: Cascade)
  company  Company?  @relation("CompanyUsers", fields: [companyId], references: [id], onDelete: Cascade)
  createdBySuperAdmin User? @relation("SuperAdminCreatedUsers", fields: [createdBySuperAdminId], references: [id], onDelete: SetNull)
  createdSuperAdmins User[] @relation("SuperAdminCreatedUsers")
  ownedBuildings Building[] @relation("SuperAdminBuildings")

  employee Employee? @relation("EmployeeAccount")
  idReservations UserIdReservation[]
  identities EntityIdentity[]
  cardEnrollments RfidEnrollment[]
  createdVisitors Visitor[] @relation("VisitorCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buildingId])
  @@index([companyId])
  @@index([createdBySuperAdminId])
  @@index([username])
  @@map("users")
}

model Building {
  parkingLimitsEnabled Boolean @default(true)
  antiPassbackEnabled Boolean @default(true)
  enabled        Boolean @default(true)
  id             String @id @default(cuid())
  name           String @unique
  totalParking   Int
  ownerParking   Int
  visitorParking Int    @default(0)
  companyParking Int
  maximumGate    Int    @default(1)
  superAdminId   String?

  superAdmin User? @relation("SuperAdminBuildings", fields: [superAdminId], references: [id], onDelete: SetNull)
  users     User[]    @relation("BuildingUsers")
  companies Company[]
  readers RfidReader[]
  rfidEvents RfidEvent[]
  gates Gate[]
  ownerVehicles BuildingOwnerVehicle[]
  ownerCardEnrollments RfidEnrollment[] @relation("OwnerParkingBuilding")
  visitors Visitor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([superAdminId])
  @@map("buildings")
}

model Gate {
  id         String   @id @default(cuid())
  buildingId String
  gateNumber Int
  direction  String   @default("SELECT")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, gateNumber])
  @@index([buildingId])
  @@map("gates")
}

model Company {
  id                        String @id @default(cuid())
  name                      String
  enabled                   Boolean @default(true)
  parkingAllocation         Int    @default(0)
  totalPersons              Int    @default(0)
  ownerParkingAllocation    Int    @default(0)
  visitorParkingAllocation  Int    @default(0)
  employeeParkingAllocation Int    @default(0)
  maximumDepartments        Int    @default(10)

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  users User[] @relation("CompanyUsers")
  employees Employee[]
  departments CompanyDepartment[]
  vehicles Vehicle[]
  cardEnrollments RfidEnrollment[]
  rfidEvents RfidEvent[]
  visitors Visitor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildingId, name])
  @@index([buildingId])
  @@map("companies")
}

model CompanyDepartment {
  id        String @id @default(cuid())
  companyId String
  name      String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("company_departments")
}

model Employee {
  id            String @id @default(cuid())
  name          String
  userId        String @unique
  companyId     String
  accountId     String? @unique
  category      String @default("EMPLOYEE")
  parkingLimit  Int    @default(1)
  department    String @default("Unassigned")
  isPlaceholder Boolean @default(false)
  slotNumber    Int?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account User? @relation("EmployeeAccount", fields: [accountId], references: [id], onDelete: SetNull)
  vehicles Vehicle[]
  cardEnrollments RfidEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, isPlaceholder])
  @@unique([companyId, slotNumber])
  @@map("employees")
}

model Vehicle {
  id          String   @id @default(cuid())
  ownerName   String
  plateNumber String
  vehicleType String
  isStaff     Boolean  @default(false)
  department  String
  rfidCardNo  String? @unique
  rfidBlocked Boolean @default(false)
  isInside Boolean @default(false)
  lastAccessAt DateTime?
  lastAccessDevice String?
  cardEnrollments RfidEnrollment[]
  rfidEvents RfidEvent[]
  companyId   String
  employeeId  String

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([employeeId])
  @@unique([companyId, plateNumber])
  @@index([companyId, isInside])
  @@map("vehicles")
}

model BuildingOwnerVehicle {
  id               String   @id @default(cuid())
  ownerName        String
  plateNumber      String
  vehicleType      String
  rfidCardNo       String?  @unique
  rfidBlocked      Boolean  @default(false)
  isInside         Boolean  @default(false)
  lastAccessAt     DateTime?
  lastAccessDevice String?
  buildingId       String

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rfidEvents RfidEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildingId, plateNumber])
  @@index([buildingId])
  @@index([buildingId, isInside])
  @@map("building_owner_vehicles")
}

model EntityIdentity {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  userId     String   @unique

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([entityType, entityId])
  @@index([entityType, entityId])
  @@map("entity_identities")
}

model UserIdReservation {
  id        String @id @default(cuid())
  userId    String
  ownerId   String
  kind      String
  scopeId   String
  nameKey   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([expiresAt])
  @@index([userId])
  @@map("user_id_reservations")
}

model Visitor {
  id              String   @id @default(cuid())
  name            String
  phoneNumber     String
  email           String
  vehicleNumber   String?
  accessory       String
  buildingId      String
  companyId       String?
  createdByUserId String?
  validFrom       DateTime
  validUntil      DateTime
  isInside        Boolean  @default(false)
  lastAccessAt    DateTime?
  lastAccessDevice String?
  qrToken         String?
  qrEntryUsed     Boolean  @default(false)

  building  Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("VisitorCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  rfidEvents RfidEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buildingId, createdAt])
  @@index([companyId, createdAt])
  @@index([buildingId, isInside])
  @@index([companyId, isInside])
  @@index([createdByUserId])
  @@map("visitors")
}

model RfidReader {
  id           String   @id @default(cuid())
  deviceNumber String   @unique
  readerProtocol String @default("QR")
  name         String
  mode         String   @default("ENTRY_EXIT")
  enabled      Boolean  @default(false)
  buildingId   String?
  lastSeenAt   DateTime?
  heartbeatSeconds Int @default(0)
  connectionType String @default("HTTP")
  readerIp String?
  sourcePort Int?
  tcpConnected Boolean @default(false)
  connectionId String?
  lastGatewaySeenAt DateTime?
  registrationQrData String? @db.Text
  entryExitQrData String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  building    Building?        @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  enrollments RfidEnrollment[]
  events      RfidEvent[]

  @@index([buildingId])
  @@map("rfid_readers")
}

model RfidEnrollment {
  id           String   @id @default(cuid())
  readerId     String
  ownerId      String
  companyId    String?
  employeeId   String?
  buildingId   String?
  ownerParking Boolean  @default(false)
  vehicleId    String?
  cardNo       String?
  status       String   @default("WAITING")
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reader   RfidReader @relation(fields: [readerId], references: [id], onDelete: Cascade)
  owner    User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  company  Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee?  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  building Building?  @relation("OwnerParkingBuilding", fields: [buildingId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([readerId, status])
  @@index([ownerId])
  @@index([buildingId])
  @@map("rfid_enrollments")
}

model RfidEvent {
  id             String   @id @default(cuid())
  readerId       String?
  buildingId     String?
  companyId      String?
  vehicleId      String?
  ownerVehicleId String?
  visitorId      String?
  deviceNumber   String
  cardNo         String
  action         String
  code           String
  message        String
  createdAt      DateTime @default(now())

  reader       RfidReader?           @relation(fields: [readerId], references: [id], onDelete: SetNull)
  building     Building?             @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  company      Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  ownerVehicle BuildingOwnerVehicle? @relation(fields: [ownerVehicleId], references: [id], onDelete: SetNull)
  visitor      Visitor?              @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  @@index([buildingId, createdAt])
  @@index([companyId, createdAt])
  @@index([readerId, createdAt])
  @@index([ownerVehicleId])
  @@index([visitorId])
  @@map("rfid_events")
}

model CloudCOffline {
  serial String @id
  enabled Boolean @default(false)
  slotStart Int
  slotCount Int
  timezone Int
  utcOffsetMinutes Int @default(0)
  slots Json @default("[]")
  fingerprint String @default("")
  plannedAt DateTime?
  checkedAt DateTime?
  lastAckAt DateTime?
  lastError String?
  @@map("cloudc_offline")
}

model CloudCCommand {
  id Int @id @default(autoincrement())
  serial String
  frame String @db.Text
  status String @default("PENDING")
  attempts Int @default(0)
  sentAt DateTime?
  createdAt DateTime @default(now())
  @@index([serial, status, id])
  @@map("cloudc_commands")
}

model CloudCHistory {
  id String @id
  serial String
  kind String
  recordIndex String
  packet Json
  receivedAt DateTime @default(now())
  @@index([serial, receivedAt])
  @@map("cloudc_history")
}

model ManualExitNotification {
  id String @id @default(cuid())
  eventId String? @unique
  targetKind String
  targetId String
  targetAccessAt DateTime?
  status String @default("PENDING")
  approvedById String?
  approvedByName String?
  approvedAt DateTime?
  buildingId String
  buildingName String
  actorId String
  actorName String
  vehicleNumber String
  personName String
  cardNo String
  createdAt DateTime @default(now())
  reads ManualExitNotificationRead[]
  @@index([buildingId, createdAt])
  @@map("manual_exit_notifications")
}

model ManualExitNotificationRead {
  notificationId String
  userId String
  readAt DateTime @default(now())
  notification ManualExitNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  @@id([notificationId, userId])
  @@index([userId])
  @@map("manual_exit_notification_reads")
}

model LocalAccessGateway {
  id String @id @default(cuid())
  serial String @unique
  host String
  tokenHash String @unique
  enabled Boolean @default(true)
  @@map("local_access_gateways")
}
